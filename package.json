{
  "name": "spreadsheet",
  "version": "0.0.1",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "1.1.0",
    "@webgpu/types": "0.1.40",
    "concurrently": "9.1.0",
    "prettier": "3.2.5"
  },
  "scripts": {
    "dev": "concurrently -n watch,serve \"bun run --bun watch\" \"bun run --bun serve\"",
    "serve": "bun --hot run index.ts",
    "watch": "bun build ./src/client/main.ts --outfile=main.js --outdir=dist --sourcemap --watch",
    "build-dev": "bun build.ts && du -sh dist/main.js",
    "clean": "rm -rf dist",
    "build-prod": "bun build.ts --env production && du -sh dist/main.js"
  },
  "peerDependencies": {
    "typescript": "5.6.3"
  },
  "type": "module",
  "dependencies": {
    "wgpu-matrix": "3.2.0"
  }
}
